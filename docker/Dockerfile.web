FROM node:25-alpine AS builder
WORKDIR /app
COPY apps/web/package.json apps/web/package.json
COPY apps/web/package-lock.json apps/web/package-lock.json
COPY apps/web ./apps/web
WORKDIR /app/apps/web

ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN npm ci --legacy-peer-deps && npm run build

FROM node:25-alpine
WORKDIR /app
# node_modules is required at runtime (`next start`); public/ for static assets.
COPY --from=builder --chown=node:node /app/apps/web/.next ./.next
COPY --from=builder --chown=node:node /app/apps/web/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/apps/web/package.json ./package.json
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=20s \
    CMD wget -qO- http://127.0.0.1:3000/ > /dev/null || exit 1
CMD ["npm", "start"]
