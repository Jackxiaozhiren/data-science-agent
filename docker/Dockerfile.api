FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "uv==0.12.7" \
    && groupadd -r appuser && useradd -r -g appuser appuser
COPY pyproject.toml uv.lock .python-version README.md LICENSE ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY packages ./packages
COPY apps ./apps
COPY src ./src
# The read-only artifact endpoints (dsa_api.routers.artifacts) serve these; the web image deliberately does
# not carry them, which is why they were being read off a filesystem that is not there (audit §167).
# Copied file-by-file rather than by directory: `benchmarks/` on disk is 2.8 GB (9 tracked files under
# benchmarks/external/), while the two artifacts these endpoints read total ~141 KB.
COPY benchmarks/baseline/summary.json ./benchmarks/baseline/summary.json
COPY benchmarks/v2/catalog.json ./benchmarks/v2/catalog.json
# The demo seeder runs at boot and locates its own tree by `examples/datasets`, then reads the CSVs named in
# `benchmarks/v2/catalog.json` from `benchmarks/v2/datasets`. Neither was copied, so the shipped image raised
# `RuntimeError: no repository root with examples/datasets above /app/...` inside `demo_seed.repo_root()`, the boot
# hook logged "demo seeding was skipped, so the first screen may be empty", and the deployed instance answered
# `{"datasets":[],"total":0}` (audit §222). These two directories are 3 and 30 tracked files, 40 KB and 392 KB --
# small enough to copy by directory, unlike the 2.8 GB `benchmarks/` the block above deliberately avoids.
COPY examples/datasets ./examples/datasets
COPY benchmarks/v2/datasets ./benchmarks/v2/datasets
COPY research/results ./research/results
RUN uv sync --no-dev --locked --all-packages \
    && mkdir -p /app/data/datasets /var/data/datasets /var/data/artifacts \
    && chown -R appuser:appuser /app /var/data
# `/var/data` is created here, with its owner set, because that is the mount point the persistence blueprint
# uses (deploy/render-persistent.example.yaml). A Docker-named volume mounted at a path that already exists in
# the image adopts that directory's ownership; mounted at a path that does not exist, it arrives owned by root.
# The service then runs as `appuser` and cannot chown its own data directory at runtime, so SQLite answers
# "attempt to write a readonly database" -- a failure that surfaces on the first write after the disk is
# attached, not before. Creating it here is what makes attaching the disk a one-step action; verified end to
# end only by the deploy itself (audit §226).
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=20s \
    CMD python -c "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/health',timeout=5)"
CMD ["/bin/sh", "-c", "exec .venv/bin/uvicorn dsa_api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
