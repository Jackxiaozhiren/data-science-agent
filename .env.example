# Hosted/local web ↔ API wiring
# This URL is embedded into the browser bundle at web build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated web origins allowed to call the FastAPI service.
DSA_CORS_ORIGINS=http://localhost:3000

# Opt-in bearer-token auth for self-hosting (empty = public demo mode).
# When set, all /api/* routes require `Authorization: Bearer <token>`;
# /health, /ready, /version stay public for probes.
# DSA_AUTH_TOKEN=

# Add model/provider credentials required by the LLM adapter you choose.
# Never commit real secrets to this file or to the repository.
