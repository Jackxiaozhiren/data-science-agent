# Hosted/local web ↔ API wiring
# This URL is embedded into the browser bundle at web build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated web origins allowed to call the FastAPI service.
DSA_CORS_ORIGINS=http://localhost:3000

